!CRL_VERSION = 1.0
!DEFINE ROOT = Cactus
!DEFINE ARR  = $ROOT/arrangements

# batchtools
!TARGET   = $ROOT
!TYPE     = git
!URL      = https://bitbucket.org/dradice/batchtools.git
!REPO_PATH=$1
!NAME     = batchtools
!CHECKOUT = ./batchtools

# Boost
!TARGET   = $ARR
!TYPE     = git
!URL      = https://github.com/dradice/Boost.git
!REPO_PATH= ../$2
!CHECKOUT =
LocalThorns/Boost

# Refluxing
!TARGET   = $ARR
!TYPE     = git
!URL      = https://bitbucket.org/FreeTHC/refluxing.git
!REPO_PATH= ../../arrangements/$1/../../repos/refluxing
!CHECKOUT = 
LocalThorns/Refluxing

# THCBase
!TARGET   = $ARR
!TYPE     = git
!URL      = https://bitbucket.org/FreeTHC/thcbase.git 
!REPO_PATH= $2
!CHECKOUT =
THCBase/CPPUtils
THCBase/FDCore
THCBase/HRSCCore

# THCCore
!TARGET   = $ARR
!TYPE     = git
!URL      = https://bitbucket.org/FreeTHC/thccore.git
!REPO_PATH= $2
!CHECKOUT =
THCCore/THC_Boundary
THCCore/THC_Core
THCCore/THC_HydroExcision
THCCore/THC_InitialData
THCCore/THC_LeakageBase
THCCore/THC_LeakageM0
THCCore/THC_Refluxing
THCCore/THC_SubGrid
THCCore/THC_Test
THCCore/THC_Tracer

# THCExtra
!TARGET   = $ARR
!TYPE     = git
!URL      = https://bitbucket.org/FreeTHC/thcextra.git
!REPO_PATH= $2
!CHECKOUT =
THCExtra/AddPuncture
THCExtra/BHTrackerMany
THCExtra/BNSAnalysis
THCExtra/BNSTrackerGen
THCExtra/Composition
THCExtra/EOS_Barotropic
THCExtra/EOS_Thermal
THCExtra/EOS_Thermal_Extable
THCExtra/EOS_Thermal_Hybrid
THCExtra/EOS_Thermal_Idealgas
THCExtra/EOS_Thermal_Table3d
THCExtra/FakeRates
THCExtra/ID_Switch_EOS
THCExtra/LoreneID
THCExtra/NSTracker
THCExtra/PizzaBase
THCExtra/PizzaIDBase
THCExtra/PizzaNumUtils
THCExtra/PizzaTOV
THCExtra/Units
THCExtra/WeakRates

# CTGamma
!TARGET   = $ARR
!TYPE     = git
!URL      = https://bitbucket.org/llamacode/ctgamma.git
!REPO_PATH= $2
!REPO_BRANCH = dradice/legacy
!CHECKOUT =
CTGamma/CartesianCoordinates
CTGamma/CTGBase
CTGamma/CTGConstraints
CTGamma/CTGEvolution
CTGamma/CTGGauge
CTGamma/CTGMatter
CTGamma/CTGRadiativeBC
